<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compiles Assets/Scripts/Engine exactly like the Unity asmdef of the same name.
       References mirror the asmdef so an illegal dependency fails to build here too. -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>MilitaryShogi.Engine</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/Scripts/Engine/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Rules/Rules.csproj" />
    <ProjectReference Include="../Observation/Observation.csproj" />
  </ItemGroup>
</Project>
